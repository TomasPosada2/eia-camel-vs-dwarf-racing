# Copy this file to .env and adjust values as needed. Never commit the real .env file.

# Database (used by docker-compose.yml and by the Spring Boot backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=racing_db
DB_USERNAME=racing_user
DB_PASSWORD=racing_password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-before-any-real-deployment
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Frontend
API_BASE_URL=http://localhost:8080
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
